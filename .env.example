# App under test
BASE_URL=https://inox-uat-web.pvrinox.com/

# REST API root
API_BASE_URL=http://localhost:3000/api

# Default login user — login is phone number + OTP (no password field exists).
# TEST_USERNAME is a 10-digit test phone number (any digits work, not a real
# number). TEST_PASSWORD holds the OTP: UAT accepts a fixed bypass code
# "123456" for any phone number instead of sending a real SMS — confirmed
# live. Do not use "12345" (5 digits) — the OTP field requires exactly 6.
TEST_USERNAME=9125989175
TEST_PASSWORD=123456

# API client timeout (ms)
API_TIMEOUT=30000

# Logger verbosity: debug | info | warn | error
LOG_LEVEL=info