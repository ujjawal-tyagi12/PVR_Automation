{
  "name": "pvr-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E automation framework (Pages -> Modules -> Tests)",
  "author": "hritik.kumar@appinventiv.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:smoke": "playwright test --grep @Smoke",
    "test:regression": "playwright test --grep @Regression",
    "test:p0": "playwright test --grep @P0",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --project=chromium --reporter=list,html,json",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist test-results playwright-report tta-report",
    "rules:check": "node scripts/rule-engine.js --config=rules/framework-rule-engine.json",
    "rules:changed": "node scripts/rule-engine.js --config=rules/framework-rule-engine.json --changed",
    "rules:staged": "node scripts/rule-engine.js --config=rules/framework-rule-engine.json --staged",
    "agents:init": "npx playwright install --with-deps",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.6",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
